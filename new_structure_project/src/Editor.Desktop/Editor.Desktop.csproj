<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Product>Phigros Layout Studio</Product>
    <AssemblyTitle>Phigros Layout Studio</AssemblyTitle>
    <Description>Phigros 曲目排版工作室（PLS）：曲目预览排版编辑器</Description>
    <Company>Mizuhime</Company>
    <Copyright>Copyright © 2026 Mizuhime. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <ProjectReference Include="../Editor.Core/Editor.Core.csproj" />
    <ProjectReference Include="../Editor.Application/Editor.Application.csproj" />
    <ProjectReference Include="../Editor.Formats/Editor.Formats.csproj" />
    <ProjectReference Include="../Editor.Rendering/Editor.Rendering.csproj" />
    <ProjectReference Include="../Editor.Imaging.Windows/Editor.Imaging.Windows.csproj" />
  </ItemGroup>
</Project>
